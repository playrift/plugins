import { CS2, useServerState, useState } from 'ts2';
import { Game } from '../lib/game/server-states';
import { chatMessage, clientClock } from '../lib/lib.engine';
import { chatLastoutput, chatboxMode } from '../lib/game/varcs';
import { ChatboxModeNames } from './chatbox.data';

export function chatSend(text: String, type: Int, fromChatboxMode: Int, switchTo: Int): void {
  const [mode] = useState(chatboxMode);
  const [, setLastOutput] = useState(chatLastoutput);

  if (useServerState(Game.chat_stfu) === 1) {
    if (type === 1) {
      chatMessage(`${CS2.chat_playername()}: <col=2020ef>${text}</col>`);
      return;
    }
    chatMessage(`${CS2.chat_playername()}: <col=0000ff>${text}</col>`);
    return;
  }

  let current: Int = mode;
  if (switchTo !== -1 && switchTo < ChatboxModeNames.length && switchTo !== mode) {
    setChatboxMode(switchTo);
    current = switchTo;
  }

  let sendType: Int = type;
  if (fromChatboxMode === 1) {
    if (current === 1) {
      sendType = 2;
    } else if (current === 2) {
      sendType = 3;
    }
  }

  let body: String = text;
  if (CS2.string_length(body) <= 0) {
    return;
  }
  if (sendType === 3) {
    CS2.chat_sendclan(body, sendType, 0);
    setLastOutput(clientClock());
    return;
  }
  if (sendType === 2 && CS2.compare(CS2.substring(body, 0, 1), '/') !== 0) {
    body = CS2.append('/', body);
  }
  CS2.chat_sendpublic(body, sendType);
  setLastOutput(clientClock());
}

export function friendsChatKick(player: String): void {
  chatSend('-Attempting to kick player from chat-channel...', 2, 0, -1);
  CS2.friendschat_kickuser(player);
}

export function setChatboxMode(mode: Int): void {
  const [, setMode] = useState(chatboxMode);
  setMode(mode);
  if (mode !== 0) {
    chatMessage(
      `Your chatbox mode is now set to ${ChatboxModeNames.at(mode) ?? ''} chat. To reset your mode, type <col=ef1020>/@p</col>.`,
    );
  } else {
    chatMessage(`Your chatbox mode has been reset to ${ChatboxModeNames.at(mode) ?? ''} chat.`);
  }
}
