function tabHidden(panel: Int): Boolean {
  const flashside: Int = useServerState(Game.flashside);
  if (flashside - 1 === panel) {
    return false;
  }
  const slot: ComponentId = SideSlots.at(panel) ?? -1;
  if (slot !== -1 && CS2.if_sub_has(slot)) {
    return false;
  }
  return true;
}

function mobileTabReveal(panel: Int): void {
  const hidden: Boolean = tabHidden(panel) || cutsceneHidesSide();
  if (hidden) {
    return;
  }

  switchSidePanel(panel, 0);
}

function stoneSprite(panel: Int): Sprite {
  const [selected] = useState(toplevelPanel);
  const flashside: Int = useServerState(Game.flashside);
  const [expansionDisabled] = useState(mobileTabExpansionDisabled);
  const slot: ComponentId = SideSlots.at(panel) ?? -1;
  const row = MobileTabs.at(panel);
  const highlight: Sprite = row === null ? NoSprite.NONE : row.highlight;
  const collapsible: Int = row === null ? 0 : row.expansion;
  let open: Boolean = false;
  if (slot !== -1 && CS2.if_sub_has(slot)) {
    open = true;
  }
  const flashing: Boolean = flashside - 1 === panel;
  if (selected === panel && (open || flashing)) {
    return highlight;
  }
  if (flashing && collapsible === 1 && expansionDisabled === 1) {
    return GameSprites.tli_button01_square_40x40_0;
  }
  return NoSprite.NONE;
}

function RightTabs(): Component {
  useRerenderOn(Engine.SUB_CHANGE);
  const channelsTab: Int = useServerState(Game.side_channels_tab_selected);
  const ironman: Int = useServerState(Game.ironman);
  const friendsPanel: Int = useServerState(Game.friends_panel);

  let channelsLabel: String = SideChannelLabels.get(channelsTab) ?? 'Chat-channel';
  let channelsIcon: Sprite = SideChannelIcons.get(channelsTab) ?? GameSprites.sideicons_interface_7;
  const ironmanGroup: Boolean = ironman === 4 || ironman === 5 || ironman === 6;
  if (ironmanGroup && (channelsTab === 4 || channelsTab === 5 || channelsTab === 6)) {
    channelsLabel = SideChannelLabels.get(ironman) ?? 'Chat-channel';
    channelsIcon = SideChannelIcons.get(ironman) ?? GameSprites.sideicons_interface_7;
  }
  let ironmanOp: String = '';
  if (ironmanGroup && channelsTab !== ironman) {
    ironmanOp = SideChannelLabels.get(ironman) ?? 'Chat-channel';
  }
  const channel0: String = channelsTab !== 0 ? 'Chat-channel' : '';
  const channel1: String = channelsTab !== 1 ? (SideChannelLabels.get(1) ?? '') : '';
  const channel2: String = channelsTab !== 2 ? (SideChannelLabels.get(2) ?? '') : '';
  const channel3: String = channelsTab !== 3 ? (SideChannelLabels.get(3) ?? '') : '';

  const friendsFirst: String = friendsPanel === 0 ? 'Friends List' : 'Ignore List';
  const friendsSecond: String = friendsPanel === 0 ? 'Ignore List' : 'Friends List';
  const friendsIcon: Sprite = friendsPanel === 0 ? GameSprites.sideicons_interface_8 : GameSprites.sideicons_interface_9;

  const skillsHidden: Boolean = tabHidden(Panel.SKILLS);
  const emotesHidden: Boolean = tabHidden(Panel.EMOTES);
  const musicHidden: Boolean = tabHidden(Panel.MUSIC);
  const channelsHidden: Boolean = tabHidden(Panel.CHANNELS);
  const friendsHidden: Boolean = tabHidden(Panel.FRIENDS);
  const accountHidden: Boolean = tabHidden(Panel.ACCOUNT);
  const settingsHidden: Boolean = tabHidden(Panel.SETTINGS);

  return (
    <>
      <sprite
        x="center"
        y={0}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.SKILLS)}
        hide={skillsHidden}
        noClickThrough
        options={[SidePanelOps.at(Panel.SKILLS) ?? '']}
        onOptionSelect={(event) => sideTabOp(Panel.SKILLS, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.EMOTES)}
        hide={emotesHidden}
        noClickThrough
        options={[SidePanelOps.at(Panel.EMOTES) ?? '']}
        onOptionSelect={(event) => sideTabOp(Panel.EMOTES, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 2}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.MUSIC)}
        hide={musicHidden}
        noClickThrough
        options={[SidePanelOps.at(Panel.MUSIC) ?? '']}
        onOptionSelect={(event) => sideTabOp(Panel.MUSIC, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 3}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.CHANNELS)}
        hide={channelsHidden}
        noClickThrough
        options={[channelsLabel, ironmanOp, channel0, channel1, channel2, channel3]}
        onOptionSelect={(event) => sideTabOp(Panel.CHANNELS, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 4}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.FRIENDS)}
        hide={friendsHidden}
        noClickThrough
        options={[friendsFirst, friendsSecond]}
        onOptionSelect={(event) => sideTabOp(Panel.FRIENDS, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 5}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.ACCOUNT)}
        hide={accountHidden}
        noClickThrough
        options={[SidePanelOps.at(Panel.ACCOUNT) ?? '', 'Account', 'Community', 'Useful links']}
        onOptionSelect={(event) => sideTabOp(Panel.ACCOUNT, event.option)}
      />
      <sprite
        x="center"
        y={Frame.STONE_PITCH * 6}
        w={Frame.STONE}
        h={Frame.STONE}
        sprite={stoneSprite(Panel.SETTINGS)}
        hide={settingsHidden}
        noClickThrough
        options={[SidePanelOps.at(Panel.SETTINGS) ?? '', 'Controls', 'Audio', 'Display']}
