        onOptionSelect={() => toggleTabExpansion()}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={GameSprites.side_icons_3}
        hide={inventoryHidden}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y + Frame.STONE_PITCH}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={GameSprites.side_icons_4}
        hide={equipmentHidden}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y + Frame.STONE_PITCH * 2}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={prayerIcon}
        hide={prayerHidden}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y + Frame.STONE_PITCH * 3}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={magicIcon}
        hide={magicHidden}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y + Frame.STONE_PITCH * 4}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={combatIcon}
        hide={combatHidden}
      />
      <sprite
        x="center"
        y={Frame.ICON_Y + Frame.STONE_PITCH * 5}
        w={Frame.ICON_W}
        h={Frame.ICON_H}
        sprite={journalIcon}
        hide={journalHidden}
      />
      <sprite x="center" y={Frame.EXPAND_ICON_Y} w={Frame.ICON_W} h={Frame.ICON_H} sprite={expandIcon} />
    </>
  );
}

function LogoutButton(): Component {
  useRerenderOn(Engine.SUB_CHANGE);
  const modalUp: Boolean = CS2.if_sub_has(sidemodalRef);
  return (
    <>
      <sprite
        x="center"
        y={0}
        w={Frame.BUTTON_W}
        h={Frame.BUTTON_H}
        sprite={stoneSprite(Panel.LOGOUT)}
        hide={modalUp}
        noClickThrough
        options={[SidePanelOps.at(Panel.LOGOUT) ?? '', 'World Switcher']}
        onOptionSelect={(event) => sideTabOp(Panel.LOGOUT, event.option)}
      />
      <sprite x="center" y="center" w={Frame.ICON_W} h={Frame.ICON_H} sprite={GameSprites.side_icons_39} hide={modalUp} />
    </>
  );
}

function WifiIcon(): Component {
  const [online] = useState(wifiOnline);
  const minimapToggle: Int = useServerState(Game.osm_minimap_toggle);
  let connected: Boolean = false;
  if (online === -1) {
    connected = CS2.mobile_wifiavailable();
  } else if (online === 1) {
    connected = true;
  }
  let collapsed: Boolean = false;
  if (minimapToggle !== 0) {
    collapsed = true;
  }
  useInterval(() => {
    if (clientClock() % StatusPoll.WIFI_CYCLES === 0) {
      const [, setOnline] = useState(wifiOnline);
      setOnline(CS2.mobile_wifiavailable() ? 1 : 0);
    }
  });
  onMounted(() => placeWifi(collapsed));
  onUpdated(() => placeWifi(collapsed));
  return (
    <sprite
      x="center"
      y="center"
      w="fill"
      h="fill"
      sprite={connected ? GameSprites.osm_status_icons_7 : GameSprites.osm_status_icons_5}
    />
  );
}

function placeWifi(collapsed: Boolean): void {
  if (collapsed) {
    wifiRef.props = { x: { right: 11 }, y: 7 };
  } else {
    wifiRef.props = { x: { right: Frame.WIFI_RIGHT }, y: Frame.WIFI_Y };
  }
}

function BatteryIcon(): Component {
  const [level] = useState(batteryLevel);
  const [charging] = useState(batteryCharging);
  const [until] = useState(batteryPercentUntil);
  const minimapToggle: Int = useServerState(Game.osm_minimap_toggle);
  let percent: Int = level;
  if (level === -1) {
    percent = CS2.mobile_batterylevel();
  }
  let bolt: Boolean = false;
  if (charging === -1) {
    bolt = CS2.mobile_batterycharging();
  } else if (charging === 1) {
    bolt = true;
  }
  const boltHidden: Boolean = !bolt;
  let icon: Sprite = GameSprites.osm_status_icons_3;
  if (percent > StatusPoll.HIGH) {
    icon = GameSprites.osm_status_icons_0;
  } else if (percent > StatusPoll.MID) {
    icon = GameSprites.osm_status_icons_1;
  } else if (percent > StatusPoll.LOW) {
    icon = GameSprites.osm_status_icons_2;
  }
  let showingPercent: Boolean = false;
  if (until !== -1) {
    showingPercent = true;
  }
  let collapsed: Boolean = false;
  if (minimapToggle !== 0) {
    collapsed = true;
  }

  useInterval(() => {
    const [deadline, setDeadline] = useState(batteryPercentUntil);
    if (deadline !== -1 && clientClock() >= deadline) {
      setDeadline(-1);
    }
    if (clientClock() % StatusPoll.BATTERY_CYCLES === 0) {
      const [, setLevel] = useState(batteryLevel);
      const [, setCharging] = useState(batteryCharging);
      setLevel(CS2.mobile_batterylevel());
      setCharging(CS2.mobile_batterycharging() ? 1 : 0);
    }
  });
  onMounted(() => placeBattery(collapsed));
  onUpdated(() => placeBattery(collapsed));

  return (
    <>
      {showingPercent ? (
        <>
          <sprite
            x="center"
            y="center"
            w="fill"
            h="fill"
            sprite={GameSprites.osm_status_icons_4}
            onClick={() => batteryTap()}
          />
          <text
            x={{ center: -1 }}
            y="center"
            w="fill"
            h="fill"
            font={GameFonts.font_494}
            color={FrameColor.WHITE}
            align="center"
            valign="middle"
            text={`${Math.min(100, Math.max(0, percent))}`}
          />
        </>
      ) : (
        <>
          <sprite x="center" y="center" w="fill" h="fill" sprite={icon} onClick={() => batteryTap()} />
          <sprite x="center" y="center" w="fill" h="fill" sprite={GameSprites.osm_status_icons_6} hide={boltHidden} />
        </>
      )}
    </>
  );
}

function placeBattery(collapsed: Boolean): void {
  if (collapsed) {
    batteryRef.props = { x: { right: 10 }, y: 30 };
  } else {
    batteryRef.props = { x: { right: Frame.BATTERY_RIGHT }, y: Frame.BATTERY_Y };
  }
}

function batteryTap(): void {
  const [until, setUntil] = useState(batteryPercentUntil);
  const [, setLevel] = useState(batteryLevel);
  CS2.sound_effect(GameSounds.interface_select1, 1, 0);
  if (until === -1) {
    setLevel(CS2.mobile_batterylevel());
    setUntil(clientClock() + StatusPoll.BATTERY_SHOW_CYCLES);
  } else {
    setUntil(-1);
  }
}

function ChatToggleFace(): Component {
  const [disabled] = useState(mobileChatboxDisabled);
  let off: Boolean = false;
  if (disabled === 1) {
    off = true;
  }
  onMounted(() => placeChatColumn(off));
  onUpdated(() => placeChatColumn(off));
  return (
    <>
      <sprite
        x="center"
        y="center"
        w={Frame.BUTTON_W}
        h={Frame.BUTTON_H}
        sprite={off ? GameSprites.tli_button01_rectangle_58x40_0 : GameSprites.tli_button01_rectangle_58x40_1}
      />
      <sprite
        x="center"
        y="center"
        w={ChatColumn.ICON_SIZE}
        h={ChatColumn.ICON_SIZE}
        sprite={GameSprites.options_icons_5}
      />
    </>
  );
}

function placeChatColumn(off: Boolean): void {
  chattingButtonRef.hide = off;
  chatFilterToggleRef.hide = off;
  sideLeftChatRef.props = { w: Frame.SIDE_LEFT_CHAT_W, h: off ? ChatColumn.WITHOUT_CHAT_H : ChatColumn.WITH_CHAT_H };
}

function chatToggleOp(option: Int): void {
  if (option === 1) {
    toggleChatbox();
  }
}

function CompassOps(): Component {
  const state: Int = useServerState(Game.minimap_state);
  let live: Boolean = true;
  if (state === 3 || state === 4 || state === 5) {
    live = false;
  }
  return (
    <>
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={GameFonts.font_494}
        noClickThrough
        onClick={() => opsound(0, 0)}
      />
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        font={GameFonts.font_494}
        options={live ? ['Look North', 'Look East', 'Look South', 'Look West'] : undefined}
        onOptionSelect={live ? (event) => compassOp(event.option) : undefined}
      />
    </>
  );
}

function SideContainerFrame(): Component {
  const steel: Int = useServerState(Game.side_container_steel);
  let stone: Boolean = true;
  if (steel !== 0) {
    stone = false;
  }
  onMounted(() => sizeSideContainer(stone));
  onUpdated(() => sizeSideContainer(stone));
  return <>{stone ? <StoneBox skin={StoneBoxSkin.ORNATE} /> : <SteelFrame backdrop={false} />}</>;
}

function sizeSideContainer(stone: Boolean): void {
  if (stone) {
    sideContainerRef.props = { w: Frame.SIDE_CONTAINER_W, h: Frame.SIDE_CONTAINER_H };
  } else {
    sideContainerRef.props = { w: Frame.SIDE_CONTAINER_STEEL_W, h: Frame.SIDE_CONTAINER_STEEL_H };
  }
}
