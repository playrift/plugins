              <layer static ref={side2Ref} x={0} y={0} w={Frame.SIDE_PANEL_W} h={Frame.SIDE_PANEL_H} hide />
              <layer static ref={side3Ref} x={0} y={0} w={Frame.SIDE_PANEL_W} h={Frame.SIDE_PANEL_H} hide reveal={() => resizableTabReveal(Panel.INVENTORY)} />
              <layer static ref={side4Ref} x={0} y={0} w={Frame.SIDE_PANEL_W} h={Frame.SIDE_PANEL_H} hide reveal={() => resizableTabReveal(Panel.EQUIPMENT)} />
              <layer static ref={side5Ref} x={0} y={0} w={Frame.SIDE_PANEL_W} h={Frame.SIDE_PANEL_H} hide />
              <layer static ref={side6Ref} x={0} y={0} w={Frame.SIDE_PANEL_W} h={Frame.SIDE_PANEL_H} hide />
              <layer static ref={side7Ref} x={0} y={0} w={Frame.SIDE_PANEL_W} h={Frame.SIDE_PANEL_H} hide />
              <layer static ref={side8Ref} x={0} y={0} w={Frame.SIDE_PANEL_W} h={Frame.SIDE_PANEL_H} hide />
              <layer static ref={side9Ref} x={0} y={0} w={Frame.SIDE_PANEL_W} h={Frame.SIDE_PANEL_H} hide reveal={() => resizableTabReveal(Panel.FRIENDS)} />
              <layer static ref={side10Ref} x={0} y={0} w={Frame.SIDE_PANEL_W} h={Frame.SIDE_PANEL_H} hide reveal={() => resizableTabReveal(Panel.LOGOUT)} />
