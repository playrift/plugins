        x={StoneX.X1}
        y={0}
        w={Frame.STONE_W}
        h={Frame.STONE_H}
        tiling
        sprite={stoneSprite(Panel.SKILLS)}
        hide={skillsHidden}
        options={[SidePanelOps.at(Panel.SKILLS) ?? '']}
        onOptionSelect={(event) => resizableTabOp(Panel.SKILLS, event.option)}
      />
      <sprite
        x={StoneX.X2}
        y={0}
        w={Frame.STONE_END_W}
        h={Frame.STONE_H}
        tiling
        sprite={stoneSprite(Panel.JOURNAL)}
        hide={journalHidden}
        options={[JournalTabLabels.at(journalTab) ?? '', journalOp2, journalOp3, journalOp4, '', '']}
        onOptionSelect={(event) => resizableTabOp(Panel.JOURNAL, event.option)}
      />
      <sprite
        x={StoneX.X3}
        y={0}
        w={Frame.STONE_W}
        h={Frame.STONE_H}
        tiling
        sprite={stoneSprite(Panel.INVENTORY)}
        hide={inventoryHidden}
        options={[SidePanelOps.at(Panel.INVENTORY) ?? '']}
        onOptionSelect={(event) => resizableTabOp(Panel.INVENTORY, event.option)}
      />
      <sprite
        x={StoneX.X4}
        y={0}
        w={Frame.STONE_W}
        h={Frame.STONE_H}
        tiling
        sprite={stoneSprite(Panel.EQUIPMENT)}
        hide={equipmentHidden}
        options={[SidePanelOps.at(Panel.EQUIPMENT) ?? '']}
        onOptionSelect={(event) => resizableTabOp(Panel.EQUIPMENT, event.option)}
      />
      <sprite
        x={StoneX.X5}
        y={0}
        w={Frame.STONE_W}
        h={Frame.STONE_H}
        tiling
        sprite={stoneSprite(Panel.PRAYER)}
        hide={prayerHidden}
        options={[SidePanelOps.at(Panel.PRAYER) ?? '', prayerOp2]}
        onOptionSelect={(event) => resizableTabOp(Panel.PRAYER, event.option)}
      />
      <sprite
        x={StoneX.X6}
        y={0}
        w={Frame.STONE_END_W}
