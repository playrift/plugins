import { CS2, createRef } from 'ts2';
import { textDevice } from '../lib/lib.helpers';
import { LogoutColors, LogoutContentType, LogoutCopy, LogoutLayout } from './logout.constants';
import { GameFonts, GameSprites } from '../game-assets';

export const logoutButton = createRef('logout_button');

export function Logout(): Component {
  return (
    <>
      <layer x="center" y={{ bottom: LogoutLayout.BUTTONS_BOTTOM }} w="fill" h={LogoutLayout.BUTTONS_H}>
        <text
          x="center"
          y={0}
          w="fill"
          h={LogoutLayout.BLURB_H}
          text={LogoutCopy.BLURB}
          font={GameFonts.font_495}
          color={LogoutColors.BODY}
          shadow
          align="center"
          valign="middle"
          lineHeight={LogoutLayout.LINE_H}
        />

        <layer
          x="center"
          y="center"
          w={LogoutLayout.BUTTON_W}
          h={LogoutLayout.BUTTON_H}
          options={[LogoutCopy.SWITCHER]}
        >
          <sprite
            x={LogoutLayout.PLATE_MID_X}
            y={0}
            w={LogoutLayout.PLATE_MID_W}
            h={LogoutLayout.BUTTON_H}
            sprite={GameSprites.miscgraphics_buttonmiddle_grey}
            tiling
          />
          <sprite x={0} y={0} w={LogoutLayout.PLATE_CAP} h={LogoutLayout.PLATE_CAP} sprite={GameSprites.miscgraphics_4} />
          <sprite
            x={LogoutLayout.PLATE_CAP_RIGHT_X}
            y={0}
            w={LogoutLayout.PLATE_CAP}
            h={LogoutLayout.PLATE_CAP}
            sprite={GameSprites.miscgraphics_6}
          />
          <text
            x="center"
            y="center"
            w={LogoutLayout.BUTTON_W}
            h={LogoutLayout.BUTTON_H}
            contentType={LogoutContentType.SWITCHER_LABEL}
            text={LogoutCopy.SWITCHER}
            font={GameFonts.font_496}
            color={LogoutColors.LABEL}
            hover={{ color: LogoutColors.SWITCHER_OVER }}
            shadow
            align="center"
            valign="middle"
          />
        </layer>

        <layer
          ref={logoutButton}
          x="center"
          y="bottom"
          w={LogoutLayout.BUTTON_W}
          h={LogoutLayout.BUTTON_H}
          options={[LogoutCopy.LOGOUT_OP]}
          onOptionSelect={() => CS2.logout()}
        >
          <sprite
            x={LogoutLayout.PLATE_MID_X}
            y={0}
            w={LogoutLayout.PLATE_MID_W}
            h={LogoutLayout.BUTTON_H}
            sprite={GameSprites.miscgraphics_buttonmiddle_red}
            tiling
          />
          <sprite x={0} y={0} w={LogoutLayout.PLATE_CAP} h={LogoutLayout.PLATE_CAP} sprite={GameSprites.miscgraphics_7} />
          <sprite
            x={LogoutLayout.PLATE_CAP_RIGHT_X}
            y={0}
            w={LogoutLayout.PLATE_CAP}
            h={LogoutLayout.PLATE_CAP}
            sprite={GameSprites.miscgraphics_8}
          />
          <text
            x="center"
            y="center"
            w={LogoutLayout.BUTTON_W}
            h={LogoutLayout.BUTTON_H}
            contentType={LogoutContentType.LOGOUT_LABEL}
            text={textDevice(LogoutCopy.LOGOUT_DESKTOP, LogoutCopy.LOGOUT_MOBILE)}
            font={GameFonts.font_496}
            color={LogoutColors.LABEL}
            hover={{ color: LogoutColors.LOGOUT_OVER }}
            shadow
            align="center"
            valign="middle"
          />
        </layer>
      </layer>
    </>
  );
}
