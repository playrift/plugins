import { Game } from 'rift.ui.default/lib/game/server-states';
import { useServerState } from 'ts2';

import { Skills } from './stats.constants';

export function skillHighlight(skill: Int): Int {
  if (skill === Skills.ATTACK) {
    return useServerState(Game.levelup_list_attack);
  }
  if (skill === Skills.STRENGTH) {
    return useServerState(Game.levelup_list_strength);
  }
  if (skill === Skills.RANGED) {
    return useServerState(Game.levelup_list_ranged);
  }
  if (skill === Skills.MAGIC) {
    return useServerState(Game.levelup_list_magic);
  }
  if (skill === Skills.DEFENCE) {
    return useServerState(Game.levelup_list_defence);
  }
  if (skill === Skills.HITPOINTS) {
    return useServerState(Game.levelup_list_hitpoints);
  }
  if (skill === Skills.PRAYER) {
    return useServerState(Game.levelup_list_prayer);
  }
  if (skill === Skills.AGILITY) {
    return useServerState(Game.levelup_list_agility);
  }
  if (skill === Skills.HERBLORE) {
    return useServerState(Game.levelup_list_herblore);
  }
  if (skill === Skills.THIEVING) {
    return useServerState(Game.levelup_list_thieving);
  }
  if (skill === Skills.CRAFTING) {
    return useServerState(Game.levelup_list_crafting);
  }
  if (skill === Skills.RUNECRAFT) {
    return useServerState(Game.levelup_list_runecraft);
  }
  if (skill === Skills.MINING) {
    return useServerState(Game.levelup_list_mining);
  }
  if (skill === Skills.SMITHING) {
    return useServerState(Game.levelup_list_smithing);
  }
  if (skill === Skills.FISHING) {
    return useServerState(Game.levelup_list_fishing);
  }
  if (skill === Skills.COOKING) {
    return useServerState(Game.levelup_list_cooking);
  }
  if (skill === Skills.FIREMAKING) {
    return useServerState(Game.levelup_list_firemaking);
  }
  if (skill === Skills.WOODCUTTING) {
    return useServerState(Game.levelup_list_woodcutting);
  }
  if (skill === Skills.FLETCHING) {
    return useServerState(Game.levelup_list_fletching);
  }
  if (skill === Skills.SLAYER) {
    return useServerState(Game.levelup_list_slayer);
  }
  if (skill === Skills.FARMING) {
    return useServerState(Game.levelup_list_farming);
  }
  if (skill === Skills.CONSTRUCTION) {
    return useServerState(Game.levelup_list_construction);
  }
  if (skill === Skills.HUNTER) {
    return useServerState(Game.levelup_list_hunter);
  }
  if (skill === Skills.SAILING) {
    return useServerState(Game.levelup_list_sailing);
  }
  return 0;
}
