id      = rift.ui.default
name    = Default UI
author  = Rift
description = Provides a bulk of the basic game UI. Top-level interfaces `resizable`, `classic` and `mobile`. The chat box, equipment, friends list, inventory, logout and minimap orbs.
version = 1.0.6
engine  = "^1.3.0"
entry   = co.playrift.ui.default.DefaultUiPackage

ts2     = META-INF/rift/ts2/

asset_field = item.quiver boolean false   Whether this item, worn, gives the extra ammo slot.

state_external = quiver_ammo item -1 The ammo in the worn quiver's extra slot, -1 for none.
state_external = quiver_ammo_amount int 0 How many of that ammo the quiver's extra slot holds.

external = inventory bag The player's carried items, shown in the Inventory tab.
external = inventory worn_equipment The items the player wears, shown in the Worn Equipment tab and the equipment screen.
external = item empty_slot The item an empty inventory slot draws, which shows nothing.

import = property has_examine whether an item in the UI's item slots offers Examine
import = property property_451 a worn item's first own menu option in the Worn Equipment tab
import = property property_452 a worn item's second own menu option in the Worn Equipment tab
import = property property_453 a worn item's third own menu option in the Worn Equipment tab
import = property property_454 a worn item's fourth own menu option in the Worn Equipment tab
import = property property_455 a worn item's fifth own menu option in the Worn Equipment tab
import = property property_456 a worn item's sixth own menu option in the Worn Equipment tab
import = property property_457 a worn item's seventh own menu option in the Worn Equipment tab
import = property property_458 a worn item's eighth own menu option in the Worn Equipment tab
import = property property_568 whether an item is Deadman-restricted, which the chatbox's tradeable item search leaves out
import = property ui_default_quiver whether a worn cape gives the Worn Equipment tab its extra ammo slot
import = sound_effect interface_select1 the click a button or menu option in the UI plays
